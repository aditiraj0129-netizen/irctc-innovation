# Copy to backend/.env or set in your hosting dashboard.
DATA_SOURCE=simulated
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=240
STORE_PATH=:memory:             # or e.g. ./agla_kadam.db to keep claims/preferences/reports across restarts

# Optional LLM explanations. The app works fully with LLM_ENABLED=false.
LLM_ENABLED=false
LLM_PROVIDER=anthropic          # or "openai" (any OpenAI-compatible API, set LLM_BASE_URL)
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=4

# Next round
PROVIDER_MODE=simulated         # "official" only works once authorised IRCTC/NTES access exists (stubs raise ProviderNotConfigured)
CACHE_TTL_SECONDS=5             # short cache for the dashboard/recovery views
DEMO_TOKEN=                     # optional; protects /api/demo/* on a public link

# Decision engines
WEATHER_PROVIDER=simulated      # simulated (demo only) | imd (needs IMD IP whitelisting; until then = "weather unavailable") | off
BUS_PROVIDER=demo               # demo (labelled SAMPLE buses, demo mode only) | off (no bus data connected)
