# Copy to backend/.env or set in your hosting dashboard.
DATA_SOURCE=simulated
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=240
STORE_PATH=:memory:             # or e.g. ./agla_kadam.db to keep claims/preferences/reports across restarts

# Optional LLM explanations. The app works fully with LLM_ENABLED=false.
LLM_ENABLED=false
LLM_PROVIDER=anthropic          # or "openai" (any OpenAI-compatible API, set LLM_BASE_URL)
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=4
